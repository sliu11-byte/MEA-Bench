# Sourceable HPG formal-run configuration for attack Slurm scripts.
# SeqKD/LoRD/SODA/GAD share one plain offline teacher transcript.
# Model Leeching and QEDKS keep method-specific teacher querying.

export CONDA_ENV="${CONDA_ENV:-research}"
export STORAGE_ROOT="${STORAGE_ROOT:-/path/to/storage/${USER}/A-Benchmark-for-Model-distillation-survey}"
export OUTPUT_DIR="${OUTPUT_DIR:-${STORAGE_ROOT}/outputs/attacks_full}"
export SHARED_TRANSCRIPT_ROOT="${SHARED_TRANSCRIPT_ROOT:-${STORAGE_ROOT}/outputs/shared_teacher_transcripts}"
export SHARED_TRANSCRIPT_DIR="${SHARED_TRANSCRIPT_DIR:-}"
export REQUIRE_SHARED_TRANSCRIPT="${REQUIRE_SHARED_TRANSCRIPT:-0}"
export SHARED_TRANSCRIPT_ATTACKS="${SHARED_TRANSCRIPT_ATTACKS:-seqkd lord soda gad}"
export QUERY_POOL="${QUERY_POOL:-auto}"
export QUERY_ORDERING="${QUERY_ORDERING:-auto}"
export STAGE1_CONFIG="${STAGE1_CONFIG:-attacks/configs/formal_stage1_budget.yaml}"
export SEED="${SEED:-20260701}"
export BUDGET="${BUDGET:-1000}"
export SEQKD_BUDGET="${SEQKD_BUDGET:-${BUDGET}}"
export LORD_BUDGET="${LORD_BUDGET:-${BUDGET}}"
export SODA_BUDGET="${SODA_BUDGET:-${BUDGET}}"
export QEDKS_BUDGET="${QEDKS_BUDGET:-${BUDGET}}"
export MODEL_LEECHING_BUDGET="${MODEL_LEECHING_BUDGET:-${BUDGET}}"
export GAD_BUDGET="${GAD_BUDGET:-${BUDGET}}"
export TEACHER_BACKEND="${TEACHER_BACKEND:-vllm_openai}"
export TEACHER_MODEL="${TEACHER_MODEL:-meta-llama/Llama-3.3-70B-Instruct}"
export TEACHER_ENDPOINT_URL="${TEACHER_ENDPOINT_URL:-http://127.0.0.1:8000/v1}"
export TEACHER_REQUEST_MODEL="${TEACHER_REQUEST_MODEL:-${TEACHER_MODEL}}"
export TEACHER_API_KEY="${TEACHER_API_KEY:-EMPTY}"
export TEACHER_TEMPERATURE="${TEACHER_TEMPERATURE:-0.0}"
export TEACHER_TOP_P="${TEACHER_TOP_P:-1.0}"
export TEACHER_MAX_TOKENS="${TEACHER_MAX_TOKENS:-1536}"
export STAGE1_TEACHER_MAX_NEW_TOKENS="${STAGE1_TEACHER_MAX_NEW_TOKENS:-1536}"
export VLLM_HOST="${VLLM_HOST:-0.0.0.0}"
if [[ -n "${VLLM_PORT:-}" ]]; then export VLLM_PORT; fi
export VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-2}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.90}"
export VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-4096}"
export VLLM_DTYPE="${VLLM_DTYPE:-bfloat16}"
export VLLM_API_KEY="${VLLM_API_KEY:-EMPTY}"
export VLLM_ENDPOINT_ENV_PATH="${VLLM_ENDPOINT_ENV_PATH:-${STORAGE_ROOT}/outputs/vllm_teacher/teacher_endpoint.env}"
export STUDENT_MODEL="${STUDENT_MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
export STUDENT_ENDPOINT_URL="${STUDENT_ENDPOINT_URL:-http://127.0.0.1:8001/v1}"
export STUDENT_REQUEST_MODEL="${STUDENT_REQUEST_MODEL:-${STUDENT_MODEL}}"
export STUDENT_API_KEY="${STUDENT_API_KEY:-EMPTY}"
export STUDENT_TEMPERATURE="${STUDENT_TEMPERATURE:-0.7}"
export STUDENT_TOP_P="${STUDENT_TOP_P:-1.0}"
export STUDENT_MAX_TOKENS="${STUDENT_MAX_TOKENS:-1536}"
export WARMUP_MODEL="${WARMUP_MODEL:-}"
export STUDENT_VLLM_HOST="${STUDENT_VLLM_HOST:-0.0.0.0}"
if [[ -n "${STUDENT_VLLM_PORT:-}" ]]; then export STUDENT_VLLM_PORT; fi
export STUDENT_VLLM_TENSOR_PARALLEL_SIZE="${STUDENT_VLLM_TENSOR_PARALLEL_SIZE:-1}"
export STUDENT_VLLM_GPU_MEMORY_UTILIZATION="${STUDENT_VLLM_GPU_MEMORY_UTILIZATION:-0.85}"
export STUDENT_VLLM_MAX_MODEL_LEN="${STUDENT_VLLM_MAX_MODEL_LEN:-4096}"
export STUDENT_VLLM_DTYPE="${STUDENT_VLLM_DTYPE:-bfloat16}"
export STUDENT_VLLM_API_KEY="${STUDENT_VLLM_API_KEY:-${STUDENT_API_KEY:-EMPTY}}"
export STUDENT_VLLM_ENDPOINT_ENV_PATH="${STUDENT_VLLM_ENDPOINT_ENV_PATH:-${STORAGE_ROOT}/outputs/vllm_student/student_endpoint.env}"
export SODA_LEARNING_RATE="${SODA_LEARNING_RATE:-5e-6}"
export SODA_EPOCHS="${SODA_EPOCHS:-1.0}"
export SODA_PER_DEVICE_TRAIN_BATCH_SIZE="${SODA_PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
export SODA_GRADIENT_ACCUMULATION_STEPS="${SODA_GRADIENT_ACCUMULATION_STEPS:-32}"
export SODA_MAX_LENGTH="${SODA_MAX_LENGTH:-3584}"
export SODA_MAX_PROMPT_LENGTH="${SODA_MAX_PROMPT_LENGTH:-1024}"
export SODA_MAX_GRAD_NORM="${SODA_MAX_GRAD_NORM:-1.0}"
export SODA_NONFINITE_GRADIENT_RETRIES="${SODA_NONFINITE_GRADIENT_RETRIES:-3}"
export QEDKS_MAX_FOLLOWUPS_PER_ANSWER="${QEDKS_MAX_FOLLOWUPS_PER_ANSWER:-4}"
export QEDKS_USE_PPL_SCHEDULE="${QEDKS_USE_PPL_SCHEDULE:-0}"
export QEDKS_PPL_DEVICE="${QEDKS_PPL_DEVICE:-cuda}"
export QEDKS_LEARNING_RATE="${QEDKS_LEARNING_RATE:-2e-4}"
export QEDKS_EPOCHS="${QEDKS_EPOCHS:-2.0}"
export QEDKS_LORA_R="${QEDKS_LORA_R:-16}"
export QEDKS_LORA_ALPHA="${QEDKS_LORA_ALPHA:-32}"
export QEDKS_LORA_DROPOUT="${QEDKS_LORA_DROPOUT:-0.05}"
export QEDKS_PER_DEVICE_TRAIN_BATCH_SIZE="${QEDKS_PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
export QEDKS_GRADIENT_ACCUMULATION_STEPS="${QEDKS_GRADIENT_ACCUMULATION_STEPS:-16}"
export MODEL_LEECHING_LEARNING_RATE="${MODEL_LEECHING_LEARNING_RATE:-2e-4}"
export MODEL_LEECHING_EPOCHS="${MODEL_LEECHING_EPOCHS:-2.0}"
export MODEL_LEECHING_LORA_R="${MODEL_LEECHING_LORA_R:-16}"
export MODEL_LEECHING_LORA_ALPHA="${MODEL_LEECHING_LORA_ALPHA:-32}"
export MODEL_LEECHING_LORA_DROPOUT="${MODEL_LEECHING_LORA_DROPOUT:-0.05}"
export MODEL_LEECHING_PER_DEVICE_TRAIN_BATCH_SIZE="${MODEL_LEECHING_PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
export MODEL_LEECHING_GRADIENT_ACCUMULATION_STEPS="${MODEL_LEECHING_GRADIENT_ACCUMULATION_STEPS:-16}"
export ATTACK_QUERY_CONCURRENCY="${ATTACK_QUERY_CONCURRENCY:-8}"
export ATTACK_QUERY_RETRIES="${ATTACK_QUERY_RETRIES:-3}"
export ATTACK_QUERY_RETRY_DELAY_SECONDS="${ATTACK_QUERY_RETRY_DELAY_SECONDS:-2}"
export GAD_GROUP_SIZE="${GAD_GROUP_SIZE:-8}"
export GAD_KL_BETA="${GAD_KL_BETA:-0.001}"
export GAD_LEARNING_RATE="${GAD_LEARNING_RATE:-1e-6}"
export GAD_DISCRIMINATOR_LEARNING_RATE="${GAD_DISCRIMINATOR_LEARNING_RATE:-1e-6}"
export GAD_WARMUP_LEARNING_RATE="${GAD_WARMUP_LEARNING_RATE:-5e-6}"
export GAD_WARMUP_EPOCHS="${GAD_WARMUP_EPOCHS:-1.0}"
export GAD_EPOCHS="${GAD_EPOCHS:-2.0}"
export GAD_DISCRIMINATOR_WARMUP_STEPS="${GAD_DISCRIMINATOR_WARMUP_STEPS:-10}"
export GAD_MAX_STEPS="${GAD_MAX_STEPS:--1}"
export GAD_PER_DEVICE_TRAIN_BATCH_SIZE="${GAD_PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
export GAD_GRADIENT_ACCUMULATION_STEPS="${GAD_GRADIENT_ACCUMULATION_STEPS:-1}"
export GAD_MAX_SEQ_LENGTH="${GAD_MAX_SEQ_LENGTH:-3584}"
export GAD_MAX_PROMPT_LENGTH="${GAD_MAX_PROMPT_LENGTH:-2048}"
export GAD_MAX_RESPONSE_LENGTH="${GAD_MAX_RESPONSE_LENGTH:-1536}"
export GAD_TEMPERATURE="${GAD_TEMPERATURE:-0.8}"
export GAD_TOP_P="${GAD_TOP_P:-1.0}"
